{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/schema_validation.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python .claude/hooks/task_scope.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/validate_before_write.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python .claude/hooks/orchestrator_write_scope.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "Bash(python scripts/fetch_url.py:*)",
      "Bash(python scripts/hash_compare.py:*)",
      "Bash(python scripts/clean_content.py:*)",
      "Bash(python scripts/trust_lookup.py:*)",
      "Bash(date:*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_close"
    ]
  }
}
